  "scripts": {
    "generate-types": "node scripts/generate-model-types.js",
    "prepare": "node scripts/generate-model-types.js",
    "prebuild": "node scripts/generate-model-types.js",
    "build": "nest build",
    "postbuild": "node -e \"const fs=require('fs'); if(fs.existsSync('firebase-service-account.json')){ fs.mkdirSync('dist/modules', {recursive: true}); fs.copyFileSync('firebase-service-account.json', 'dist/modules/firebase-service-account.json'); }\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "prestart:prod": "npm run build",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:all": "npm test && npx playwright test",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:cs:e2e": "node scripts/test-cs-final-e2e.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "ts-node -r tsconfig-paths/register ./node_modules/sequelize-cli/lib/sequelize db:seed:all",
    "seed:superadmin": "NODE_PATH=node_modules/.pnpm/node_modules node scripts/seed-super-admin.js",
    "migration:create": "sequelize-cli migration:create --name",
    "seeder:create": "sequelize-cli seed:generate --name",
    "sync:permissions": "node scripts/sync-permissions.js",
    "daily:report": "ts-node scripts/git-daily-report.ts",
    "push": "bash scripts/git-push.sh"
  },
