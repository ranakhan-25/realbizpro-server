<html>
  <head>
    <style>
      body {
        font-family: Arial, sans-serif;
        margin: 20px;
      }
      .error-header {
        color: #d32f2f;
        font-size: 24px;
        margin-bottom: 20px;
      }
      .error-section {
        margin-bottom: 20px;
        padding: 15px;
        border-left: 4px solid #f44336;
        background-color: #ffebee;
      }
      .error-title {
        font-weight: bold;
        color: #d32f2f;
        margin-bottom: 10px;
      }
      .code-block {
        background-color: #f5f5f5;
        padding: 10px;
        border-radius: 4px;
        font-family: monospace;
        white-space: pre-wrap;
      }
      .info-table {
        width: 100%;
        border-collapse: collapse;
      }
      .info-table th,
      .info-table td {
        padding: 8px;
        text-align: left;
        border-bottom: 1px solid #ddd;
      }
      .info-table th {
        background-color: #f2f2f2;
      }
    </style>
  </head>
  <body>
    <div class='error-header'>🚨 500 Internal Server Error Alert</div>

    <div class='error-section'>
      <div class='error-title'>Error Details</div>
      <table class='info-table'>
        <tr><th>Timestamp</th><td>{{timestamp}}</td></tr>
        <tr><th>Path</th><td>{{method}} {{path}}</td></tr>
        <tr><th>User</th><td>{{userEmail}} (ID: {{userId}})</td></tr>
        <tr><th>IP Address</th><td>{{ip}}</td></tr>
        <tr><th>User Agent</th><td>{{userAgent}}</td></tr>
      </table>
    </div>

    <div class='error-section'>
      <div class='error-title'>Error Message</div>
      <div class='code-block'>{{errorMessage}}</div>
    </div>

    <div class='error-section'>
      <div class='error-title'>Stack Trace</div>
      <div class='code-block'>{{errorStack}}</div>
    </div>

    {{#if body}}
      <div class='error-section'>
        <div class='error-title'>Request Body</div>
        <div class='code-block'>{{body}}</div>
      </div>
    {{/if}}

    {{#if query}}
      <div class='error-section'>
        <div class='error-title'>Query Parameters</div>
        <div class='code-block'>{{query}}</div>
      </div>
    {{/if}}

    <div class='error-section'>
      <div class='error-title'>Request Headers</div>
      <div class='code-block'>{{headers}}</div>
    </div>

    <p><strong>Please investigate this error immediately.</strong></p>
  </body>
</html>