<html>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>{{title}}</title>
    <style>
      body {
        font-family: 'Arial', sans-serif;
        line-height: 1.6;
        color: #333;
        max-width: 600px;
        margin: 0 auto;
        padding: 20px;
      }
      .header {
        text-align: center;
        padding: 20px 0;
        border-bottom: 2px solid #e1e1e1;
      }
      .content {
        padding: 30px 0;
      }
      .footer {
        text-align: center;
        padding-top: 20px;
        border-top: 1px solid #e1e1e1;
        font-size: 14px;
        color: #666;
      }
    </style>
  </head>
  <body>
    <div class='header'>
      <h1>{{title}}</h1>
    </div>

    <div class='content'>
      <p>{{message}}</p>

      <p>If you have any questions, please contact us at {{supportEmail}}</p>

      <p>Best regards,<br />The Team</p>
    </div>

    <div class='footer'>
      <p>This is an automated message. Please do not reply to this email.</p>
    </div>
  </body>
</html>