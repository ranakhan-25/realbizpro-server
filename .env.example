# Application Configuration
NODE_ENV=development
PORT=5002
BACKEND_DOMAIN=http://localhost
API_PREFIX=api

# CORS Configuration
CORS_ORIGIN=true

# Health Check
HEALTH_CHECK_ENABLED=true

# Security Configuration
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_MS=900000
CORS_CREDENTIALS=true
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=1d

ENGINE_SERVICE_URL=http://localhost:5002/engine

# ==========================================
# Cloud Database SSH Tunnel (Automated Docker Tunnel)
# ==========================================
SSH_HOST=103.189.5.21
SSH_PORT=22
SSH_USER=dev
SSH_PASSWORD=your_ssh_password_here

# Database Configuration (Docker connects via db-tunnel)
DATABASE_HOST=db-tunnel
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD="Easy#2198*^"
DATABASE_NAME=easy_dev
DATABASE_DIALECT=postgres
